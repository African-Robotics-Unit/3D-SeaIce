  /Width 840
  /Height 630
  /BitsPerComponent 8
  /Decode [0 1 0 1 0 1]
  /ImageMatrix [840.00 0 0 630.00 0 0]
  /DataSource currentfile
  /ASCII85Decode filter
  /FlateDecode filter
